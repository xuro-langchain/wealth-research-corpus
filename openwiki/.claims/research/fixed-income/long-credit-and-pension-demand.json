          "resource": "repo://internal_research/FI/US/PENSION-LDI/2026-03.md",
          "version": "repo-file-v1:sha256:f3fd6fad91d3b8346cfbe9f6a408d6f749a82e942e73996e04caddbef8e1b6bb"
        }
