        }
      ]
    },
    {
      "id": "claim_cd2acd86ec444745859b54f93f0a8467",
      "statement": "IRS Notice 2026-18 N.3 supersedes the FI-US-MUNI-CREDIT 2025-11 M.2 rationale for affected private-activity interest: effective for taxable years beginning on or after 2027-01-01, reduced AMT thresholds cause the retained post-1986 PAB preference to create liability for an expanded taxpayer population, matching M.2's stated invalidation condition.",
      "evidence": [
        {
          "resource": "repo://bulletins/IRS/2026-03-amt-private-activity-bond-interest.md#L9-L21",
          "version": "repo-lines-v1:sha256:1a7d19e311c7cfed8becfbe179e1787a2f917ae74a9fc6986b8d14e1d459641f:"
