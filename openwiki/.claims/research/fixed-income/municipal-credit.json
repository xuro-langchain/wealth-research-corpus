    {
      "id": "claim_44c13fb2fc144e5fbcebb900746c988d",
      "statement": "FI-US-MUNI-CREDIT edition 2025-11, applicable to positions taken on or after 2025-12-01, recommends a two- to four-percentage-point taxable-fixed-income municipal overweight funded from investment-grade corporate credit and concentrated in high-yield and lower-investment-grade private activity bonds.",
      "evidence": [
        {
          "resource": "repo://research/FI/US/MUNI-CREDIT/2025-11.md#L1-L9",
          "version": "repo-lines-v1:sha256:ffeb75d9e1cce513cb9a55e604750c9d1fb8c44b6bbac47414fb80367e862ac9:"
        }
      ]
    },
    {
      "id": "claim_8608a3e06dc84da2b61d0e6c2d05b769",
      "statement": "The 2025-11 municipal private-activity recommendation is load-bearingly an after-tax, top-federal-bracket view: if AMT thresholds or treatment draw materially more of those holders into AMT, M.1 does not survive; credit fundamentals alone support only neutral to modest overweight.",
      "evidence": [
        {
          "resource": "repo://research/FI/US/MUNI-CREDIT/2025-11.md#L11-L17",
          "version": "repo-lines-v1:sha256:8e4ed24034043927cb8d51e9991b5c05302e0a83114e20759730a9d71f4db39e:"
