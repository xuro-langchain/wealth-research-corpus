    {
      "id": "claim_8bc640fca662420f935f442c05d8b5ab",
      "statement": "IRS Notice 2026-18 applies to taxable years beginning on or after 2027-01-01 and lowers the AMT exemption to $85,700 for joint filers and $55,100 for unmarried individuals, with phase-out thresholds of $500,000 and $300,000; the stated amounts are not indexed before taxable years beginning 2030-01-01.",
      "evidence": [
        {
          "resource": "repo://bulletins/IRS/2026-03-amt-private-activity-bond-interest.md#L3-L15",
          "version": "repo-lines-v1:sha256:ee2b86a0cc71a0f59a5b4227197aa82c7112ed934605cb517aeddc89ab83df1c:"
        }
      ]
    },
    {
      "id": "claim_1b51618ceed347a89c0071652a4600a6",
      "statement": "For qualified private activity bonds issued after 1986 other than qualified 501(c)(3) bonds, interest remains an item of tax preference included in alternative minimum taxable income; the lowered thresholds can therefore cause actual AMT liability for taxpayers previously outside AMT.",
      "evidence": [
        {
          "resource": "repo://bulletins/IRS/2026-03-amt-private-activity-bond-interest.md#L17-L21",
