  "claims": [
    {
      "id": "claim_7eb851af35594140aadd4ef97f29ac16",
      "statement": "DOL Release 2026-31 is synthetic demonstration material, and within this corpus is a regulatory overlay on single-employer defined-benefit-plan funding rules—not portfolio guidance—issued in 2026-08 and effective for “plan years beginning on or after 2027-01-01.”",
      "evidence": [
        {
          "resource": "repo://external_sources/DOL/2026-08-funding-relief-and-discount-rates.md#L1-L11",
          "version": "repo-lines-v1:sha256:fc223424dfd588b34e107974a6e1a93966e19e3d8bfc1bf6e06733a4ee184ef3:"
        }
      ]
    },
    {
      "id": "claim_f895eff976b74771b0030c8a83f63591",
      "statement": "For affected plan years, DOL Release 2026-31 P.2 widens the twenty-five-year-average segment-rate corridor from 10% to “twenty percent in each direction,” permitting a higher discount rate and lower measured liabilities; a plan at or near full funding under the prior corridor will in most cases measure in surplus.",
      "evidence": [
        {
          "resource": "repo://external_sources/DOL/2026-08-funding-relief-and-discount-rates.md#L13-L17",
          "version": "repo-lines-v1:sha256:0ebc3a2c3a2a1bfd9c87ba456752aa1262f2fc07fa4947c2dd708bd987b347b5:"
        }
      ]
    },
    {
      "id": "claim_1c4ddedda32143ee83589450c794ddcc",
      "statement": "Under DOL Release 2026-31 P.3, a plan whose P.2 funded status exceeds 110% has no minimum required contribution for that plan year and its sponsor may elect to make the excess available for P.4 purposes; P.4 limits use to a qualified replacement-plan transfer or retiree health accounts and does not permit a sponsor reversion outside the existing statutory framework.",
      "evidence": [
        {
          "resource": "repo://external_sources/DOL/2026-08-funding-relief-and-discount-rates.md#L19-L25",
          "version": "repo-lines-v1:sha256:27f3620104d9ea3b108aa434cecec527d48ee724b25cf79931686a032f38a431:"
        }
      ]
    },
    {
      "id": "claim_3f46d886eac246cc9578344899efb3fa",
      "statement": "DOL Release 2026-31 P.5 preserves benefit-accrual and vesting rules and preserves in full all restrictions applicable to plans below 80% funded, while not addressing fiduciary investment standards; P.6 requires a sponsor electing P.3 relief to notify participants within 30 days.",
      "evidence": [
        {
          "resource": "repo://external_sources/DOL/2026-08-funding-relief-and-discount-rates.md#L27-L35",
          "version": "repo-lines-v1:sha256:ee1cee26b0d4296bfee78f63761797d9d0a443ce2075d1f69ab0ad6383e7ade2:"
        }
      ]
    },
    {
      "id": "claim_9e6f175331044f2fa7e86f01b6be34fb",
      "statement": "DOL Release 2026-31 P.2–P.4 supersedes FI-US-PENSION-LDI 2026-03 L.2’s pension-demand premise prospectively: the note makes contribution requirements and liability discount-rate measurement the reason surplus is protected, says surplus release or re-risking can reverse the flow, and names surplus release, discount-rate changes, and reduced contribution requirements as events invalidating its overweight.",
