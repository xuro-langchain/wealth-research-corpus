    {
      "id": "claim_c05100c59924452d8ba63944003964db",
      "statement": "SEC Order IA-7104, effective 2026-06-29, sets Rule 205-3's adjusted qualified-client tests at at least $1,400,000 under the adviser's management immediately after contract entry or an adviser's reasonable belief immediately before entry that net worth exceeds $2,700,000.",
      "evidence": [
        {
          "resource": "repo://bulletins/SEC/2026-04-order-ia-7104-qualified-client.md#L14-L18",
          "version": "repo-lines-v1:sha256:47d005692d8086255f6776eb3d77c06d940b2ece5eca4f174a79835276ccaa59:"
        }
      ]
    },
    {
      "id": "claim_a0ba28870c604ce59816cfe1f74b3bf3",
      "statement": "For the order's net-worth test, primary-residence value and debt secured by it up to fair market value are excluded, while a natural person may include jointly held spousal assets; the order does not modify those provisions.",
      "evidence": [
        {
          "resource": "repo://bulletins/SEC/2026-04-order-ia-7104-qualified-client.md#L20-L22",
          "version": "repo-lines-v1:sha256:0873b419b8c28f5c86bf78e79bad9f9656965eb2fee1d214c28c70226cf8bf50:"
        }
      ]
    },
    {
