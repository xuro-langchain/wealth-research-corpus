    {
      "id": "claim_2fce6c8540f64bf2a59aaf6a14e98119",
      "statement": "If a mandate-cited research note is superseded or withdrawn, its derived weight is suspended and must be escalated to the committee; the manager may not carry the old weight forward, re-derive a weight, or directly adopt the replacement recommendation, and the escalation identifies relevant notes, weights, and accounts.",
      "evidence": [
        {
          "resource": "repo://internal_guidelines/authority/discretion-matrix.md#L31-L37",
          "version": "repo-lines-v1:sha256:93c2875eb41c4d9d6bc1a7dd3f0c9f21808162dc3ced64387038d6a5ba1ea4c9:"
        }
