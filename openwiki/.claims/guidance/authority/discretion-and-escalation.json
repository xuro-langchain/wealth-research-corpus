    {
      "id": "claim_0c6a8f8890fe4238919ac09f8d822290",
      "statement": "Portfolio managers have base discretion; senior portfolio managers have expanded discretion and may clear one escalation condition per account; Committee approval is required for matters beyond senior discretion, accounts with more than one escalation condition, and exceptions to stated bands. Mandate-specific guides may tighten but not broaden this authority.",
      "evidence": [
        {
          "resource": "repo://guidelines/authority/discretion-matrix.md#L7-L11",
          "version": "repo-lines-v1:sha256:3def3a374be9a7730d29fd5ab66538c38dc3ad1f3b13c3751fe0ab1c819cea86:"
        }
      ]
    },
    {
      "id": "claim_aacbf11dd763495bb551aa99d66457c9",
      "statement": "Single-issuer positions up to 3% of account market value are within portfolio-manager discretion, positions up to 5% are within senior portfolio-manager discretion, and positions above 5% require Committee approval plus a written concentration rationale; such positions are also subject to the concentrated-position guide.",
      "evidence": [
        {
