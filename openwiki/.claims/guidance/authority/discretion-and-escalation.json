    {
      "id": "claim_b19547e82b5b48108787fbea9cb2bdb7",
      "statement": "Authority is tiered by portfolio-manager, senior-manager, and committee limits: managers may hold a single issuer up to 3% of account market value, seniors up to 5% and may clear one escalation condition per account, while the committee is required above 5%, for more than one escalation condition, and for band exceptions.",
      "evidence": [
        {
          "resource": "repo://internal_guidelines/authority/discretion-matrix.md#L7-L15",
          "version": "repo-lines-v1:sha256:512a8249fb880778a9763e96b0a8f9cc4a623270108c3e8d0d6a730167608126:"
        }
      ]
    },
    {
      "id": "claim_f87643ccfbf540e5aa301b43bf752cd2",
      "statement": "Conditions requiring approval regardless of size include stated-band exceptions other than suspension-caused breaches, binding research-underweight sectors, concentrated-position hedges, municipal-duration extensions, and private-markets commitments after eligibility determination.",
