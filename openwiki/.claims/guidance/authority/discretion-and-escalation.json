  "claims": [
    {
      "id": "claim_c0f828c4ffe1462ea024402a0975085b",
      "statement": "Mandate-specific guidance may impose tighter limits but cannot grant discretion broader than the firm-wide discretion matrix; senior portfolio managers may clear one escalation condition per account, while matters beyond senior discretion, accounts with more than one condition, and stated-band exceptions require Committee approval.",
      "evidence": [
        {
          "resource": "repo://internal_guidelines/authority/discretion-matrix.md#L1-L11",
          "version": "repo-lines-v1:sha256:1021efca79515c6cf6aa0d2f67d596f1326a3f2e90ddac634451bfc869f4f24c:"
        }
      ]
    },
    {
      "id": "claim_71c44f40c96549b7b69c7c3212848023",
      "statement": "Single-issuer positions up to 3% of account market value are within portfolio-manager discretion, senior portfolio managers may take up to 5%, and positions above 5% require Committee approval and a written concentration rationale before becoming subject to the concentrated-position guide.",
      "evidence": [
        {
          "resource": "repo://internal_guidelines/authority/discretion-matrix.md#L13-L15",
          "version": "repo-lines-v1:sha256:05f4d72c5a4de854e2d8a88ccd13989f4f164818be580948472670d6311a46c2:"
        }
      ]
    },
    {
      "id": "claim_273c190db1ef4bf28fd94397b5d46eac",
      "statement": "A concentrated position is more than 15% of a client's liquid portfolio market value, or more than 10% for employer or affiliate securities, and requires documented suitability at acquisition and each annual review covering the holding reason, tax cost of unwinding, and restrictions.",
      "evidence": [
        {
          "resource": "repo://internal_guidelines/suitability/concentrated-positions.md#L7-L19",
          "version": "repo-lines-v1:sha256:2142b9f14cd3f84af6708cbc09b5a36e3bb4389b9378b6953d730f56e9adb0de:"
        }
      ]
    },
    {
      "id": "claim_91c391cd582b4d29ba7880e82879eb33",
      "statement": "Approval is required regardless of size for stated-band exceptions other than suspension breaches, binding underweight-sector positions, concentrated-position hedges, municipal-duration extensions, and private-markets commitments; the last also requires eligibility to be determined before approval is sought.",
      "evidence": [
        {
          "resource": "repo://internal_guidelines/authority/discretion-matrix.md#L17-L29",
          "version": "repo-lines-v1:sha256:38c93853d8d6ab5a143090c6ba253ff187b7785e3085d58df9137c736ce49f5c:"
        }
      ]
    },
    {
      "id": "claim_edb7b6f0b571497e83a7dba10244ee75",
      "statement": "A cited research note that is superseded or withdrawn suspends its guide-derived weight; the manager must escalate to the Committee rather than carrying forward, re-deriving, or directly adopting a replacement recommendation, and the record identifies the old note, replacement if any, derived weights, and affected accounts.",
      "evidence": [
        {
          "resource": "repo://internal_guidelines/allocation/us-taxable-fixed-income.md#L7-L11",
          "version": "repo-lines-v1:sha256:c222887e024fb196bbdb1a3f0e942a017c456e326a12f4fff3570a923c9c089a:"
