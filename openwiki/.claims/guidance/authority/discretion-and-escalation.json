    },
    {
      "id": "claim_a5dd348d14b649cc9a9bb5cbf6918d36",
      "statement": "Mandate guides define the immediate treatment of a research suspension: global multi-asset bands return to the prior committee-adopted level pending review, while taxable fixed income suspends the paired municipal overweight and corporate underweight to neutral and does not mechanically rebalance a suspension-caused breach.",
      "evidence": [
        {
          "resource": "repo://internal_guidelines/allocation/gl-multi-asset-bands.md#L7-L11",
          "version": "repo-lines-v1:sha256:fd3df0a17ac1db48524625797e670aac5b58e053b781d7525bb416add5b038e5:"
