    {
      "id": "claim_4ee40f8efcbf40b59a3621c1d0454d84",
      "statement": "The municipal overweight is an after-tax, top-bracket position rather than a credit-only position: the supporting research says private-activity paper's advantage appears only after tax and the fundamental case alone supports only neutral to modest overweight.",
      "evidence": [
        {
          "resource": "repo://guidelines/allocation/us-taxable-fixed-income.md#L19-L23",
          "version": "repo-lines-v1:sha256:c68a26881750b4eaf945292fbdb663c22a2d9860f76b05f935343108bca3dd16:"
