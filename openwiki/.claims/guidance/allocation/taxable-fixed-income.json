    {
      "id": "claim_1805c4d996414328869e86ab2e810263",
      "statement": "This binding internal guidance governs the US taxable fixed-income sleeve for US taxable client accounts—US Treasuries, agency MBS, investment-grade corporates, and municipal credit—while non-US sovereign and emerging-market debt remain governed by the multi-asset sleeve guidance.",
      "evidence": [
        {
          "resource": "repo://guidelines/allocation/us-taxable-fixed-income.md#L1-L15",
          "version": "repo-lines-v1:sha256:e18a17e2711ca4184917e8e3840b15caec972e7cb3946e6dc893bd54d472bd42:"
        }
      ]
    },
    {
      "id": "claim_a0f3f4b4098f4a80a65ed6d1d0b15768",
      "statement": "For top federal marginal-bracket clients, municipal credit has a 22% target against an 18% neutral weight, while clients below the top bracket remain at the 18% neutral municipal weight without the private-activity concentration.",
      "evidence": [
        {
          "resource": "repo://guidelines/allocation/us-taxable-fixed-income.md#L17-L23",
          "version": "repo-lines-v1:sha256:008b63307c128094a6ac8cbf9ac50127983559e55ffd1101214614c429ff895b:"
