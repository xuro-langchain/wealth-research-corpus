        }
      ]
    },
    {
      "id": "claim_b481b73d6cad4045917d39dcf44c82e8",
      "statement": "Investment-grade corporate credit has a 28% target against a 32% neutral weight; its four-percentage-point underweight funds the municipal overweight, and suspension of the municipal overweight returns both municipal and corporate positions to neutral.",
      "evidence": [
        {
          "resource": "repo://guidelines/allocation/us-taxable-fixed-income.md#L33-L37",
