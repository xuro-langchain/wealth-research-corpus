    },
    {
      "id": "claim_037386ebe9cf458f9aa278f9a09d53c6",
      "statement": "Within the municipal allocation, no more than 35% may be in any one preferred sector; positions in standalone senior living, single-asset student housing, or single-obligor industrial-development paper require approval; municipal duration is restricted to 8–15 years and extensions cannot be granted portfolio-wide.",
      "evidence": [
