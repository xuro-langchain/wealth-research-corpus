    },
    {
      "id": "claim_f437d7fe91244a649fd3107fd65c1e58",
      "statement": "The taxable fixed-income sleeve comprises US Treasuries, agency MBS, investment-grade corporate credit, and municipal credit; non-US sovereign and emerging-market debt are assigned to the multi-asset sleeve.",
      "evidence": [
        {
          "resource": "repo://internal_guidelines/allocation/us-taxable-fixed-income.md#L13-L15",
          "version": "repo-lines-v1:sha256:f40297e796350b729e45da304e39a0a4a7354e915e3c26ef0cc408221c4de736:"
        }
      ]
    },
    {
      "id": "claim_6d927da8fd3b419b88cffd0afba573a2",
      "statement": "The live guide specifies a 22% municipal target versus 18% neutral for top-bracket clients and a 28% investment-grade-corporate target versus 32% neutral; if the municipal overweight is later suspended, its paired corporate underweight is also suspended and both return to neutral.",
      "evidence": [
        {
          "resource": "repo://internal_guidelines/allocation/us-taxable-fixed-income.md#L17-L23",
          "version": "repo-lines-v1:sha256:008b63307c128094a6ac8cbf9ac50127983559e55ffd1101214614c429ff895b:"
