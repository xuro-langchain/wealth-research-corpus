    {
      "id": "claim_15c2b96f117044fe850ae50b6deaf03a",
      "statement": "The Investment Policy Committee's 2026-03-04 global multi-asset guidance sets the strategic default at 45% global equities, 35% global fixed income, 10% real assets, and 10% private markets for eligible clients; for ineligible clients, the private-markets allocation is reallocated pro rata across liquid sleeves.",
      "evidence": [
        {
          "resource": "repo://internal_guidelines/allocation/gl-multi-asset-bands.md#L1-L5",
          "version": "repo-lines-v1:sha256:985acf19f180fe9312db1b2a4ceda071d024aea4057e020e4ce218119ec62f73:"
        },
        {
          "resource": "repo://internal_guidelines/allocation/gl-multi-asset-bands.md#L13-L16",
          "version": "repo-lines-v1:sha256:4f388ea5cc9c6f36f8f22bf2b0ebf640c44d8bb2fb0908bf320fa2556391f557:"
        }
      ]
    },
    {
      "id": "claim_5869d710b7554cc496e5c66c2ce7960b",
      "statement": "The ordinary tolerance bands are \u00b15 percentage points for equities and fixed income and \u00b13 for real assets; private markets has no ordinary band because it cannot be traded, and a weight outside a stated band requires approval under the discretion matrix.",
