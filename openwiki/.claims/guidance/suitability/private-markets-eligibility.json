        }
      ]
    },
    {
      "id": "claim_1c6e833d0ff247269e6477bf5a395457",
      "statement": "A properly made pre-effective-date qualified-client determination remains valid only with respect to its earlier contract or private-fund investment; it must not be relied upon for a contract or investment entered on or after the effective date.",
