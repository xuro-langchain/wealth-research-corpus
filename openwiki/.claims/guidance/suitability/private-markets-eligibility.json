          "version": "repo-lines-v1:sha256:f5a285ef98530aa200f6183964732c399711b67b37a30ff0ac7a91aad1c05fb5:"
        }
      ]
    },
    {
      "id": "claim_7a790e58e53a4f8babbded23cef160db",
      "statement": "A qualified-purchaser determination properly made before 2026-01-01 remains valid and does not require divestment, but it cannot support a new determination or a new commitment on or after the effective date; a carried-forward file must identify the prior thresholds used.",
      "evidence": [
