    },
    {
      "id": "claim_6106bed4b06244babe2e9ec7160f771d",
      "statement": "SEC Release 2025-08 Q.2 applies to determinations made on or after 2026-01-01, raises the qualified-purchaser investments threshold to $6.2 million for a natural person and $31 million for a family company, and provides for indexation every five years; firm guidance implements that release rather than treating a copied threshold as permanently operative.",
      "evidence": [
        {
          "resource": "repo://bulletins/SEC/2025-08-qualified-purchaser-threshold.md#L9-L13",
          "version": "repo-lines-v1:sha256:f233c3fb9de6097c355d42adea277b94ff287c2c992ae03b0eb1ea4102cfcef6:"
