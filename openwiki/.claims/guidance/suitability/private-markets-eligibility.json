    {
      "id": "claim_7a790e58e53a4f8babbded23cef160db",
      "statement": "A qualified-client determination made before 2026-06-29 remains valid for the pre-effective-date advisory contract or private-fund investment and does not require divestment, but it cannot support a contract, investment, or new subscription on or after that date; the carried-forward file must identify that prior thresholds were used.",
      "evidence": [
