    {
      "id": "claim_d8dac8d87f66412593f782d371c39eca",
      "statement": "A concentrated position requires a documented suitability determination at acquisition and every annual review, recording the client’s holding rationale, tax cost of unwinding, and restrictions; the file must also show that concentration risk was explained and the client made an informed decision, because preference to hold alone is insufficient.",
      "evidence": [
        {
          "resource": "repo://internal_guidelines/suitability/concentrated-positions.md#L11-L19",
          "version": "repo-lines-v1:sha256:d4dbe3b9aca06b1b123fa678b4b5bb05cc0d03064f63b616f5e93a5e76faf778:"
        }
