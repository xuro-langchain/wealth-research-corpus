    {
      "id": "claim_1346e30c0a2e4a5ab0a26c4a9ff3674f",
      "statement": "A position is concentrated when it exceeds 15% of the client’s liquid portfolio market value, with a more-than-10% threshold for the client’s employer or an affiliate; the discretion matrix separately requires Committee approval and a written concentration rationale above 5% of account market value and then subjects the position to the concentrated-position guide.",
      "evidence": [
