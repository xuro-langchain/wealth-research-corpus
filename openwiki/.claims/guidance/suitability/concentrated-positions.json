  "claims": [
    {
      "id": "claim_8a8eb091add4471397e46f999657f510",
      "statement": "A single-security position is concentrated when it exceeds 15% of the client’s liquid portfolio market value, with a lower threshold of more than 10% when the security is the client’s employer or an affiliate.",
      "evidence": [
        {
          "resource": "repo://guidelines/suitability/concentrated-positions.md#L7-L10",
          "version": "repo-lines-v1:sha256:3a68da1bc323cfdc71377d3942ea9084c67f4b699bf78636ad8b7b1408f511a3:"
        }
      ]
    },
    {
      "id": "claim_743d352da7b34b64baee50744b39419a",
      "statement": "Concentration classification is separate from initiation authority: managers may take issuer positions up to 3% and senior managers up to 5% of account market value, while positions above 5% require committee approval and a written concentration rationale and remain subject to the concentrated-position suitability requirement.",
      "evidence": [
        {
          "resource": "repo://guidelines/authority/discretion-matrix.md#L13-L15",
          "version": "repo-lines-v1:sha256:05f4d72c5a4de854e2d8a88ccd13989f4f164818be580948472670d6311a46c2:"
        },
        {
          "resource": "repo://guidelines/suitability/concentrated-positions.md#L11-L13",
          "version": "repo-lines-v1:sha256:702712f2c7be23d2ce562faafc223a95592f9af828b54950fb0ff94923d45780:"
        }
      ]
    },
    {
      "id": "claim_c5406724cab649e486ea064db574b043",
      "statement": "Each concentrated position requires a documented suitability determination at acquisition and at every annual review that records the client’s reason for holding, unwind tax cost, and any restriction preventing an unwind.",
      "evidence": [
        {
          "resource": "repo://guidelines/suitability/concentrated-positions.md#L11-L13",
          "version": "repo-lines-v1:sha256:702712f2c7be23d2ce562faafc223a95592f9af828b54950fb0ff94923d45780:"
        }
      ]
    },
    {
      "id": "claim_0e5e2b992c6b4b2398c7542090430a73",
      "statement": "A retention preference alone is not a suitability determination: the file must document that concentration risk was explained and the client’s decision was informed, and low tax basis does not excuse the determination or establish suitability.",
      "evidence": [
        {
          "resource": "repo://guidelines/suitability/concentrated-positions.md#L15-L19",
          "version": "repo-lines-v1:sha256:bccbbdbbfc9c07f2ce310f77008097c69f9453682d9802553ee91a3be96dffef:"
        }
      ]
    },
    {
      "id": "claim_c14e0f14ae0242bfb8d8f030b40b3919",
      "statement": "Hedging a concentrated position requires D.3 approval regardless of size, and collars, prepaid forwards, and exchange funds require written treatment of tax consequences before execution.",
      "evidence": [
        {
          "resource": "repo://guidelines/authority/discretion-matrix.md#L17-L29",
          "version": "repo-lines-v1:sha256:38c93853d8d6ab5a143090c6ba253ff187b7785e3085d58df9137c736ce49f5c:"
